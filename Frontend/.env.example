# ============================================
# Communication Hub Frontend - Environment
# ============================================

# Base URL for backend HTTP API.
# Default behavior (if missing): http://localhost:5270
VITE_HUB_API_BASE_URL=http://localhost:5270

# SignalR hub URL used by the internal SignalR adapter.
# Supports relative path (same origin) or absolute URL.
# Default behavior (if missing): http://localhost:5270/chatHub
VITE_HUB_SIGNALR_URL=http://localhost:5270/chatHub

# Optional feature flag to hide Admin Dashboard UI on host.
# true  => admin UI can render based on role permissions.
# false => admin UI always hidden in frontend.
# Default behavior (if missing): true
VITE_HUB_ENABLE_ADMIN_DASHBOARD=true

# Legacy optional variable used by some avatar URL generation logic.
# Leave empty unless your host requires this naming.
VITE_API_BASE_URL=

